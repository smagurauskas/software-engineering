@page "/"
@inject CatalogClient Api

<h1>Catalog</h1>
<p class="lead">
    A Blazor WebAssembly client for the REST API from 02-http-api. This C# runs in the browser, calls
    the same endpoints as the React version, and needs the same number of requests.
</p>

@if (error is not null)
{
    <p class="error">@error</p>
}

<div class="columns">
    <section>
        <h2>Authors</h2>
        <ul class="authors">
            <li>
                <button type="button" class="@(selectedAuthorId is null ? "selected" : "")" @onclick="() => SelectAuthorAsync(null)">
                    All books
                </button>
            </li>
            @foreach (var author in authors)
            {
                <li>
                    <button type="button" class="@(selectedAuthorId == author.Id ? "selected" : "")" @onclick="() => SelectAuthorAsync(author.Id)">
                        @author.Name
                        <span class="country">@author.Country</span>
                    </button>
                </li>
            }
        </ul>
    </section>

    <section>
        <h2>Books</h2>
        @if (books.Count == 0)
        {
            <p class="empty">No books here yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Year</th>
                        <th>ISBN</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in books)
                    {
                        <tr class="@(details?.Book.Id == book.Id ? "selected" : "")">
                            <td>
                                <button type="button" class="link" @onclick="() => ShowDetailsAsync(book.Id)">@book.Title</button>
                            </td>
                            <td>@NameOf(book.AuthorId)</td>
                            <td>@book.Year</td>
                            <td class="isbn">@book.Isbn</td>
                            <td>
                                <button type="button" class="danger" @onclick="() => DeleteAsync(book.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (details is null)
        {
            <p class="empty">Pick a title to load its author and editions.</p>
        }
        else
        {
            <div class="details">
                <h3>@details.Book.Title</h3>
                <p>@details.Author.Name, @details.Author.Country, @details.Book.Year</p>
                <ul>
                    @foreach (var edition in details.Editions)
                    {
                        <li>@edition.Format, @edition.Pages pages, @edition.Year</li>
                    }
                </ul>
                @if (details.Editions.Count == 0)
                {
                    <p class="empty">No editions on record.</p>
                }
            </div>
        }

        <h2>Add a book</h2>
        <div class="form">
            <label>
                Title
                <input @bind="draftTitle" />
                @if (fieldErrors.TryGetValue("Title", out var titleErrors))
                {
                    <span class="field-error">@string.Join(" ", titleErrors)</span>
                }
            </label>

            <label>
                Author
                <select @bind="draftAuthorId">
                    <option value="">Pick an author</option>
                    @foreach (var author in authors)
                    {
                        <option value="@author.Id">@author.Name</option>
                    }
                </select>
                @if (fieldErrors.TryGetValue("AuthorId", out var authorErrors))
                {
                    <span class="field-error">@string.Join(" ", authorErrors)</span>
                }
            </label>

            <label>
                Year
                <input type="number" @bind="draftYear" />
                @if (fieldErrors.TryGetValue("Year", out var yearErrors))
                {
                    <span class="field-error">@string.Join(" ", yearErrors)</span>
                }
            </label>

            <label>
                ISBN
                <input @bind="draftIsbn" />
                @if (fieldErrors.TryGetValue("Isbn", out var isbnErrors))
                {
                    <span class="field-error">@string.Join(" ", isbnErrors)</span>
                }
            </label>

            <button type="button" disabled="@isSaving" @onclick="CreateAsync">
                @(isSaving ? "Saving" : "Create book")
            </button>

            @if (message is not null)
            {
                <p class="message">@message</p>
            }
        </div>
    </section>
</div>

<section class="log">
    <h2>
        HTTP requests: <strong>@Api.History.Count</strong>
        <span class="total">@Api.History.Sum(entry => entry.Bytes) bytes received</span>
        <button type="button" @onclick="ResetAsync">Reset</button>
    </h2>
    <ol>
        @foreach (var entry in Api.History)
        {
            <li>
                <code>@entry.Label</code>
                <span class="meta">@entry.Status @entry.Bytes B @entry.Milliseconds ms</span>
            </li>
        }
    </ol>
</section>

@code {
    private List<Author> authors = [];
    private List<Book> books = [];
    private Guid? selectedAuthorId;
    private BookDetails? details;
    private Dictionary<string, string[]> fieldErrors = [];
    private string? error;
    private string? message;
    private bool isSaving;

    private string draftTitle = string.Empty;
    private string draftAuthorId = string.Empty;
    private int draftYear;
    private string draftIsbn = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private string NameOf(Guid authorId) =>
        authors.FirstOrDefault(author => author.Id == authorId)?.Name ?? "unknown";

    private async Task LoadAsync()
    {
        try
        {
            authors = await Api.GetAuthorsAsync();
            books = selectedAuthorId is null
                ? await Api.GetBooksAsync()
                : await Api.GetBooksOfAuthorAsync(selectedAuthorId.Value);
            error = null;
        }
        catch (Exception reason)
        {
            error = Describe(reason);
        }
    }

    private async Task SelectAuthorAsync(Guid? authorId)
    {
        selectedAuthorId = authorId;
        details = null;

        await LoadAsync();
    }

    private async Task ShowDetailsAsync(Guid id)
    {
        details = null;

        try
        {
            var book = await Api.GetBookAsync(id);
            var author = await Api.GetAuthorAsync(book.AuthorId);
            var editions = await Api.GetEditionsAsync(id);

            details = new BookDetails(book, author, editions);
            error = null;
        }
        catch (Exception reason)
        {
            error = Describe(reason);
        }
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        message = null;
        fieldErrors = [];

        try
        {
            Guid.TryParse(draftAuthorId, out var authorId);

            await Api.CreateBookAsync(new BookCreateRequest(draftTitle, authorId, draftYear, draftIsbn));

            draftTitle = string.Empty;
            draftAuthorId = string.Empty;
            draftYear = 0;
            draftIsbn = string.Empty;
            message = "Created.";

            await LoadAsync();
        }
        catch (ApiException reason) when (reason.Problem?.Errors is not null)
        {
            fieldErrors = reason.Problem.Errors;
        }
        catch (Exception reason)
        {
            message = Describe(reason);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await Api.DeleteBookAsync(id);

            details = null;

            await LoadAsync();
        }
        catch (Exception reason)
        {
            error = Describe(reason);
        }
    }

    private async Task ResetAsync()
    {
        Api.ClearHistory();

        details = null;

        await LoadAsync();
    }

    private static string Describe(Exception reason) =>
        reason switch
        {
            ApiException problem => $"{problem.Status} {problem.Message}",
            _ => "The REST API did not answer. Is it running on http://localhost:5080?",
        };
}

# Quarto
/.quarto/
/_site/
/_freeze/

# Rendered output (slides/pages are built by CI or locally, never committed).
# Quarto writes these next to the .qmd files, i.e. only in the repo root -
# example apps (Vite, Blazor wwwroot) have real index.html sources.
/*.html
# Support files (bootstrap, clipboard, ...) left behind by a local render.
/*_files/

# Verification scratch (generated .csx scripts and actual outputs)
/.verify/

# .NET
bin/
obj/
*.user
**.lscache

# Jupyter (legacy notebooks)
.ipynb_checkpoints/

# Editors / OS
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Used for some examples
test.txt

**/*.quarto_ipynb
